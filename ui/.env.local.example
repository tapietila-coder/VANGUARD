# Copy to .env.local. The UI's server-side code (page fetches and the
# /api/services/[id] proxy route) reads VANGUARD_API_BASE. Only override this
# if the backend isn't at the default local address/port.
VANGUARD_API_BASE=http://127.0.0.1:8788

# Required for the Service Control start/stop/restart buttons on /services
# (proxied server-side, never sent to the browser). Must match the backend's
# VANGUARD_API_TOKEN. If left unset, both sides fall back to the same
# dev-only insecure default token, so it works out of the box in dev mode.
# VANGUARD_API_TOKEN=
