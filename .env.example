# Copy to .env and fill in real values. Never commit .env.

# Required outside dev: random 24+ character secret. In dev mode (VANGUARD_ENVIRONMENT=dev,
# the default) a local-only fallback token is used if this is left blank.
VANGUARD_API_TOKEN=REPLACE_WITH_RANDOM_SECRET

VANGUARD_ENVIRONMENT=dev
VANGUARD_DB_PATH=./data/vanguard.db
VANGUARD_NODE_STALE_SECONDS=300

# Read-only probe target for the real local D27HQ_DISPATCH service, if running.
VANGUARD_DISPATCH_BASE_URL=http://127.0.0.1:8787

# Service Control: where the real local Dispatch checkout lives and which
# interpreter runs it (its own venv). Leave blank to use the real on-disk
# default (../Dispatch/D27HQ_DISPATCH relative to this project's parent,
# i.e. NCTIAPP/Dispatch/D27HQ_DISPATCH) — override only if it's elsewhere.
VANGUARD_DISPATCH_DIR=
VANGUARD_DISPATCH_PYTHON=

# Mesh provider: "null" (default, honest no-op) or "netbird" once a real NetBird
# management server exists. Target version policy: see docs/MESH.md.
VANGUARD_MESH_PROVIDER=null
NETBIRD_BASE_URL=
NETBIRD_API_TOKEN=

# Job Queue: how many worker threads run queued jobs concurrently (a small
# local ThreadPoolExecutor, not a distributed queue), and where
# audit_log_export writes its JSON snapshots.
VANGUARD_JOB_WORKERS=2
VANGUARD_JOB_EXPORT_DIR=./data/exports
